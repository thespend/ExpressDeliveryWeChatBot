
# 基础信息配置！
TOKEN=token值 (官网获取：www.wechatbot.online)
ROBOT_ID=机器人微信DI(官网获取：www.wechatbot.online)
SERVER_IP=服务器IP(官网获取：www.wechatbot.online)
SERVER_PORT=5555

# 统一回复模板
RESPONSE_M='已加急联系快递处理了！'

# 触发关键词
KEYWORDS=['拦截', '退回', '拒收', '催件', '催更', '催促', '地址']

# 各快递公司售后群昵称（可多填写）！
# 申通快递  例如：['申通售后群1','申通售后群2','申通售后群3',...]
STO=['申通售后群']

# 中通快递  例如：['中通售后群1','中通售后群2','中通售后群3',...]
ZTO=['大鹏D中通(吉州分部)售后对接群','大鹏D中通(工业园)售后对接群']

# 韵达快递  例如：['韵达售后群1','韵达售后群2','韵达售后群3',...]
YDA=['大鹏D韵达(庐陵)售后对接群','大鹏D韵达(吉贤路)售后对接群']

# 邮政快递  例如：['邮政售后群1','邮政售后群2','邮政售后群3',...] 必须包含关键词：吉安 /安福县 /吉水县 做区分的标准！
EMS=['大鹏D邮政(安福县)售后对接群','大鹏D邮政(吉安)售后对接群','大鹏D邮政(吉水县)售后对接群']

# 圆通快递  例如：['圆通售后群1','圆通售后群2','圆通售后群3',...]
YTO=['圆通售后群']

# 极兔快递  例如：['极兔售后群1','极兔售后群2','极兔售后群3',...]
JTE=['大鹏D极兔(庐陵)售后对接群']

# 顺丰快递  例如：['顺丰售后群1','顺丰售后群2','顺丰售后群3',...]
SFE=['顺丰售后群']


# ==================== 截单提醒配置 ====================
# 截单提醒消息模板（支持变量：{time} 表示截单时间点）
CUTOFF_REMINDER_MESSAGE='亲，今日的截单点（{time}）将至，麻烦检查一下系统里是否有未审核的订单，谢谢！'

# 提前提醒时间（分钟）- 在截单时间点前多少分钟发送提醒
ADVANCE_REMINDER_MINUTES=30